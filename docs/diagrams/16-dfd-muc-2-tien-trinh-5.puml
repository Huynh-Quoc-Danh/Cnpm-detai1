@startuml dfd-muc-2-tien-trinh-5
' DFD mức 2 – tiến trình 5.0 Thống kê và báo cáo
skinparam monochrome true
skinparam shadowing false
skinparam rectangle<<process>> {
  RoundCorner 30
}
hide stereotype
left to right direction

rectangle "Quản trị viên" as QT

rectangle "5.1\n----\nTheo dõi khách\ntrực tiếp" as P51 <<process>>
rectangle "5.2\n----\nTổng hợp doanh thu,\nlượt nghe" as P52 <<process>>
rectangle "5.3\n----\nXuất CSV đơn hàng" as P53 <<process>>

database "D7 Khách truy cập" as D7
database "D4 Đơn hàng" as D4
database "D8 Lượt nghe" as D8
database "D1 Địa điểm" as D1

D7 --> P51 : khách online
P51 --> QT : khách đang online
P51 --> P52 : số khách online

D4 --> P52 : đơn đã trả
D8 --> P52 : lượt nghe
D1 --> P52 : tên địa điểm
P52 --> QT : báo cáo, biểu đồ

D4 --> P53 : đơn hàng
D1 --> P53 : tên địa điểm
P53 --> QT : tệp CSV
@enduml
