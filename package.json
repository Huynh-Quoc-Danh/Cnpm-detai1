    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
