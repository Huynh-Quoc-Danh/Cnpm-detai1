# Kết nối MySQL / MariaDB (XAMPP mặc định: user root, không mật khẩu, cổng 3306).
# Sao chép file này thành .env rồi sửa cho đúng máy của bạn.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=halong
# DB_POOL_SIZE=10
# PORT=3001
# MySQL trên cloud (TiDB Cloud, Aiven…) cần kết nối mã hoá – bật dòng dưới khi triển khai:
# DB_SSL=true
